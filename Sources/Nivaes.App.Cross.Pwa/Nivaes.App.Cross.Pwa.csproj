<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Nivaes.App.Cross.Pwa</PackageId>
		<Title>Nivaes app Cross PWA</Title>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
		<Product>Cross librery for PWA.</Product>
		<Description>Cross librery for PWA.</Description>
		<PackageTags>Nivaes;cross;mvvm;PWA</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nivaes.App.Cross\Nivaes.App.Cross.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nivaes.App.Cross.Pwa.SourceGenerator\Nivaes.App.Cross.Pwa.SourceGenerator.csproj">
			<PrivateAssets>runtime; build; native; contentfiles; buildtransitive</PrivateAssets>
			<IncludeAssets>analyzers</IncludeAssets>
			<ExcludeAssets>runtime; build; native; contentfiles; buildtransitive</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
