		<None Include="..\..\sources\Nivaes.App.Cross.UIKit\bin\$(Configuration)\$(_CrossiOSTargets)\Nivaes.App.Cross.UIKit.dll;
					   ..\..\sources\Nivaes.App.Cross.UIKit\bin\$(Configuration)\$(_CrossiOSTargets)\Nivaes.App.Cross.UIKit.pdb;
