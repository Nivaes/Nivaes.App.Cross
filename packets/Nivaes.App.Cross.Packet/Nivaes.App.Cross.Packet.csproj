					   ..\..\sources\Nivaes.App.Cross\bin\$(Configuration)\$(_CrossCommonTargets)\Nivaes.App.Cross.pdb;
					   ..\..\sources\Nivaes.App.Cross\bin\$(Configuration)\$(_CrossCommonTargets)\Nivaes.App.Cross.xml"
			  Pack="true"
			  PackagePath="lib\$(_CrossAndroidTargets)$(_CrossAndroidVersion)\" />
	
		<None Include="..\..\sources\Nivaes.App.Cross.Droid\bin\$(Configuration)\$(_CrossAndroidTargets)\Nivaes.App.Cross.Droid.dll;
			           ..\..\sources\Nivaes.App.Cross.Droid\bin\$(Configuration)\$(_CrossAndroidTargets)\Nivaes.App.Cross.Droid.pdb;
			           ..\..\sources\Nivaes.App.Cross.Droid\bin\$(Configuration)\$(_CrossAndroidTargets)\Nivaes.App.Cross.Droid.xml"
