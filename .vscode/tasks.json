{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build iOS Simulator",
            "type": "shell",
            "command": "dotnet build samples/Nivaes.App.Cross.Sample.UIKit.iOS -f net10.0-ios -p:RuntimeIdentifier=iossimulator-x64",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
           {
            "label": "Run iOS Simulator",
            "type": "shell",
            "command": "${workspaceFolder}/run-ios.sh",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run iOS Simulator with Hot Reload",
            "type": "shell",
            "command": "${workspaceFolder}/run-ios-watch.sh",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run iOS Simulator",
            "type": "shell",
            "command": "dotnet watch samples/Nivaes.App.Cross.Sample.UIKit.iOS -f net8.0-ios run -p:RuntimeIdentifier=iossimulator-x64",
            "group": "build",
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", 
                "${workspaceFolder}/Nivaes.App.Cross/Nivaes.App.Cross.WinUI/Nivaes.App.Cross.WinUI.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": ["publish",
                "${workspaceFolder}/Nivaes.App.Cross/Nivaes.App.Cross.WinUI/Nivaes.App.Cross.WinUI.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": ["watch","run","--project",                
                "${workspaceFolder}/Nivaes.App.Cross/Nivaes.App.Cross.WinUI/Nivaes.App.Cross.WinUI.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}