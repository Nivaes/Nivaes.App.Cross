<Project>
	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1507;1591</NoWarn>

		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<PropertyGroup>
		<_SupportedOSPlatformMacOSVersion>13.0</_SupportedOSPlatformMacOSVersion>

		<_SupportedOSPlatformiOSVersion>15.8</_SupportedOSPlatformiOSVersion>
		<_TargetPlatformiOSVersion>26.0</_TargetPlatformiOSVersion>

		<_SupportedOSPlatformMacCatalystVersion>15.0</_SupportedOSPlatformMacCatalystVersion>
		<_TargetPlatformMacCatalystVersion>26.0</_TargetPlatformMacCatalystVersion>

		<_SupportedOSPlatformTvOSVersion>15.8</_SupportedOSPlatformTvOSVersion>
		<_TargetPlatformTvOSVersion>26.0</_TargetPlatformTvOSVersion>

		<_SupportedOSPlatformAndroidVersion>23.0</_SupportedOSPlatformAndroidVersion>
		
		<_SupportedOSPlatformWindowsVersion>10.0.22000.0</_SupportedOSPlatformWindowsVersion>
		<_TargetPlatformWinodwsMinVersion>10.0.19041.0</_TargetPlatformWinodwsMinVersion>
    </PropertyGroup>

	<PropertyGroup>
		<_CrossCommonTargets>net10.0</_CrossCommonTargets>
		<_CrossAndroidTargets>net10.0-android</_CrossAndroidTargets>
		<_CrossiOSTargets>net10.0-ios</_CrossiOSTargets>
		<_CrossMacCatalystTargets>net10.0-maccatalyst</_CrossMacCatalystTargets>
		<_CrossMacOSTargets>net10.0-macos</_CrossMacOSTargets>
		<_CrossTvOSTargets>net10.0-tvos</_CrossTvOSTargets>
		<_CrossWindowsTargets>net10.0-windows10.0.22000.0</_CrossWindowsTargets>
	</PropertyGroup>

	<PropertyGroup>
		<_CrossTargetFrameworks>$(_CrossCommonTargets)</_CrossTargetFrameworks>
		<!-- Windows-specific targets -->
		<_CrossTargetFrameworks Condition=" $([MSBuild]::IsOSPlatform('windows')) ">$(_CrossAndroidTargets);$(_CrossiOSTargets);$(_CrossMacCatalystTargets);$(_CrossMacOSTargets);$(_CrossTvOSTargets);$(_CrossWindowsTargets);$(TargetFrameworks)</_CrossTargetFrameworks>
		<!-- Linux-specific targets -->
		<_CrossTargetFrameworks Condition=" $([MSBuild]::IsOSPlatform('linux')) ">$(_CrossAndroidTargets);$(TargetFrameworks)</_CrossTargetFrameworks>
		<!-- Mac-specific targets -->
		<_CrossTargetFrameworks Condition=" $([MSBuild]::IsOSPlatform('osx')) ">$(_CrossAndroidTargets);$(_CrossiOSTargets);$(_CrossMacCatalystTargets);$(_CrossMacOSTargets);$(_CrossTvOSTargets);$(TargetFrameworks)</_CrossTargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">$(_SupportedOSPlatformMacOSVersion)</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(_SupportedOSPlatformiOSVersion)</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(_TargetPlatformiOSVersion)</TargetPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(_SupportedOSPlatformMacCatalystVersion)</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(_TargetPlatformMacCatalystVersion)</TargetPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">$(_SupportedOSPlatformTvOSVersion)</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">$(_TargetPlatformTvOSVersion)</TargetPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(_SupportedOSPlatformAndroidVersion)</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(_SupportedOSPlatformWindowsVersion)</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(_TargetPlatformWinodwsMinVersion)</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<IncludeSymbols>true</IncludeSymbols>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en</NeutralLanguage>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>
	
	<PropertyGroup>
		<Copyright>Copyright (c) Nivaes Systems S.L.</Copyright>
		<PackageProjectUrl>https://github.com/Nivaes/Nivaes.App.Cross</PackageProjectUrl>
		<Authors>Nivaes Systems</Authors>
		<Owners>Nivaes</Owners>
		<PackageReleaseNotes>https://www.nivaes.com</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
	</PropertyGroup>

	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<PropertyGroup>
		<IsTestProject>$(MSBuildProjectName.Contains('UnitTest'))</IsTestProject>
		<IsBenchmarksProject>$(MSBuildProjectName.Contains('Benchmarks'))</IsBenchmarksProject>
		<IsSampleProject>$(MSBuildProjectName.Contains('Sample'))</IsSampleProject>

		<GenerateDocumentationFile Condition=" '$(Configuration)' == 'Release' ">true</GenerateDocumentationFile>
	</PropertyGroup>
</Project>
