<Project>
	<PropertyGroup>
		<Copyright>Copyright (c) Nivaes Systems S.L.</Copyright>
		<PackageProjectUrl>https://github.com/Nivaes</PackageProjectUrl>
		<Authors>Nivaes Systems</Authors>
		<Owners>Nivaes</Owners>
		<PackageReleaseNotes>https://www.nivaes.com</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1507;1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.8</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.5</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<_CrossCommonTargets>net9.0</_CrossCommonTargets>
		<_CrossAndroidTargets>net9.0-android</_CrossAndroidTargets>
		<_CrossiOSTargets>net9.0-ios;net9.0-maccatalyst</_CrossiOSTargets>
		<_MvxMacOSTargets>net9.0-macos</_MvxMacOSTargets>
		<_CrossTvOSTargets>net9.0-tvos</_CrossTvOSTargets>
		<_CrossWindowsTargets>net9.0-windows10.0.19041.0;</_CrossWindowsTargets>
		<_MvxWpfTargets>net9.0-windows</_MvxWpfTargets>
	</PropertyGroup>

	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/nivaes/Professional365</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<Product>$(AssemblyName) ($(TargetFramework))</Product>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<DebugType>full</DebugType>

		<NeutralLanguage>en</NeutralLanguage>
		<VersionPrefix>0.0.1</VersionPrefix>
		<VersionSuffix>-dev-0.2</VersionSuffix>
	</PropertyGroup>

	<PropertyGroup>
		<EnablePackageValidation>true</EnablePackageValidation>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<PropertyGroup>
		<IsTestProject>$(MSBuildProjectName.Contains('UnitTest'))</IsTestProject>
		<IsBenchmarksProject>$(MSBuildProjectName.Contains('Benchmarks'))</IsBenchmarksProject>
		<IsSampleProject>$(MSBuildProjectName.Contains('Sample'))</IsSampleProject>

		<GenerateDocumentationFile Condition=" '$(Configuration)' == 'Release' ">true</GenerateDocumentationFile>
		<GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' and '$(IsTestProject)' != 'true' and '$(IsBenchmarksProject)' != 'true' and '$(IsSampleProject)' != 'true'">true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>

		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSymbols>true</IncludeSymbols>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<DesignTimeBuild>false</DesignTimeBuild>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>

	</PropertyGroup>

</Project>
