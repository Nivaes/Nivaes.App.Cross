<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<!--<Platforms>x86;x64;arm64</Platforms>-->
		<!--<RuntimeIdentifiers >android-x86;android-x64;android-arm64</RuntimeIdentifiers>-->
		
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>com.nivaes.app.sample.cross</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<!--		
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
		<IsPackable>false</IsPackable>
		<!--<GeneratePackageOnBuild>false</GeneratePackageOnBuild>-->

		<!--<IsAotCompatible>true</IsAotCompatible>-->

		<!--<PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>-->
		<PublishAot>true</PublishAot>
		
		<!--<AndroidPackageFormat>aab</AndroidPackageFormat>-->
		<!--<SelfContained>true</SelfContained>-->
		<!--<AndroidSupportedAbis>arm64-v8a;armeabi-v7a;x86_64</AndroidSupportedAbis>-->
		<!--<PublishTrimmed>true</PublishTrimmed>-->
		<!--<IlcOptimizationPreference>Speed</IlcOptimizationPreference>-->
		<!--<RunAOTCompilation>true</RunAOTCompilation>-->
		<!--<TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>-->
		

		<!--<AndroidAotAssembly>true</AndroidAotAssembly>-->
		<!--<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>-->
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nivaes.App.Shared" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" />
	</ItemGroup>
	<!--<ItemGroup>
		<AdditionalFiles Include="Resources/layout/*.xml" />
	</ItemGroup>-->
	<ItemGroup>
		<ProjectReference Include="..\..\sources\Nivaes.App.Cross.Droid.SourceGenerator\Nivaes.App.Cross.Droid.SourceGenerator.csproj">
			<OutputItemType>Analyzer</OutputItemType>
			<ReferenceOutputAssembly>true</ReferenceOutputAssembly>

			<PrivateAssets>runtime; build; native; contentfiles; buildtransitive</PrivateAssets>
			<IncludeAssets>analyzers</IncludeAssets>
			<ExcludeAssets>runtime; build; native; contentfiles; buildtransitive</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\..\sources\Nivaes.App.Cross.Droid\Nivaes.App.Cross.Droid.csproj" />
		<ProjectReference Include="..\Nivaes.App.Cross.Sample\Nivaes.App.Cross.Sample.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Update="Roslynator.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Update="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>
</Project>